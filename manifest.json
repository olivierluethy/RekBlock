{
  "manifest_version": 2,
  "name": "URL Blocker",
  "version": "1.0",
  "description": "A simple extension to block URLs.",
  "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage", "tabs"],
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html"
  }
}
