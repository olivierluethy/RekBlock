{
  "manifest_version": 3,
  "name": "Web Site Blocker",
  "version": "1.1.0",
  "description": "Block distracting websites and URLs to stay focused. Simple Chrome extension for productivity and website blocking.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16":  "icon/icon16.png",
    "48":  "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}