{
    "manifest_version": 2,
    "name": "URL Blocker",
    "version": "1.0",
    "description": "A simple extension to block URLs.",
    "permissions": [
      "webRequest",
      "webRequestBlocking",
      "<all_urls>",
      "storage"
    ],
    "background": {
      "scripts": ["background.js"],
      "persistent": true
    },
    "browser_action": {
      "default_popup": "popup.html"
    }
  }